{
    "name": "irodevnet/turkish-seo-text",
    "description": "Turkish text tools for SEO: a light stemmer that respects vowel harmony, Ateşman readability, Turkish-aware lower-casing and keyword and phrase analysis. English stemming and Flesch included.",
    "type": "library",
    "license": "MIT",
    "keywords": ["turkish", "türkçe", "stemmer", "kök bulma", "seo", "readability", "okunabilirlik", "ateşman", "keyword density", "nlp"],
    "homepage": "https://github.com/irodevltd/turkish-seo-text",
    "authors": [
        {
            "name": "İRODEV LTD",
            "email": "info@irodev.net",
            "homepage": "https://irodev.net"
        }
    ],
    "support": {
        "issues": "https://github.com/irodevltd/turkish-seo-text/issues",
        "source": "https://github.com/irodevltd/turkish-seo-text"
    },
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Irodev\\TurkishText\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Irodev\\TurkishText\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
